// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// User roles: ADMIN, MEMBER, GUEST (stored as String in SQLite)
// Married status: SINGLE, MARRIED, WIDOWED, DIVORCED (stored as String in SQLite)
// Spouse gender: MALE, FEMALE (stored as String in SQLite)

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  fullName      String?
  role          String    @default("GUEST")  // ADMIN, MEMBER, GUEST
  isActive      Boolean   @default(true)
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  joinedAt      DateTime? // Membership approved date (null for GUEST, set when approved)

  // Contact info (required for all users)
  phone         String?
  address       String?
  city          String?
  state         String?
  zipCode       String?

  // Faith-related fields
  gender        String?   // MALE, FEMALE (required for all users)
  isBaptized    Boolean   @default(false)
  whenBaptized  DateTime?
  marriedStatus String?   // SINGLE, MARRIED, WIDOWED, DIVORCED
  spouseGender  String?   // MALE, FEMALE (required if married)

  // Admin-specific fields (required when role is ADMIN)
  ministryRole    String?
  responsibility  String?
  officePhone     String?

  // Relations
  sessions            Session[]
  accounts            Account[]
  fellowshipGroups    FellowshipGroup[]
  memberships         FellowshipMembership[]
  joinRequests        GroupJoinRequest[]
  membershipRequests  MembershipRequest[]
  userRequests        UserRequest[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Fellowship Group Module
// Membership roles: LEADER, MEMBER
model FellowshipGroup {
  id          String   @id @default(cuid())
  name        String
  description String?
  schedule    String?   // e.g., "Every Sunday 10:00 AM"
  imageUrl    String?
  maxMembers  Int       @default(20)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String

  createdBy    User                   @relation(fields: [createdById], references: [id])
  members      FellowshipMembership[]
  events       Event[]
  joinRequests GroupJoinRequest[]
}

model FellowshipMembership {
  id        String   @id @default(cuid())
  userId    String
  groupId   String
  role      String   @default("MEMBER")  // LEADER or MEMBER
  joinedAt  DateTime @default(now())

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  group FellowshipGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
}

// Join request status: PENDING, APPROVED, REJECTED
model GroupJoinRequest {
  id        String   @id @default(cuid())
  userId    String
  groupId   String
  status    String   @default("PENDING")  // PENDING, APPROVED, REJECTED
  message   String?  // Optional message from requester
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  group FellowshipGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
}

// Events for homepage
model Event {
  id          String   @id @default(cuid())
  title       String
  description String?
  imageUrl    String?
  startDate   DateTime
  endDate     DateTime?
  location    String?
  groupId     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  group FellowshipGroup? @relation(fields: [groupId], references: [id])
}

// Photo Gallery
model Photo {
  id          String   @id @default(cuid())
  title       String?
  url         String
  description String?
  createdAt   DateTime @default(now())
}

// Contact submissions
model Contact {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String
  createdAt DateTime @default(now())
  isRead    Boolean  @default(false)
}

// User Requests - consolidated request system
// Category: MEMBERSHIP, GROUP
// Request Types for MEMBERSHIP: APPLY_NEW, TRANSFER_IN, TRANSFER_OUT
// Request Types for GROUP: JOIN_GROUP, LEAVE_GROUP
// Status: INITIAL (draft), SUBMITTED, APPROVED, DECLINED
model UserRequest {
  id              String   @id @default(cuid())
  userId          String
  category        String   // MEMBERSHIP, GROUP
  requestType     String   // APPLY_NEW, TRANSFER_IN, TRANSFER_OUT, JOIN_GROUP, LEAVE_GROUP
  title           String   // Display title for the request
  status          String   @default("INITIAL")  // INITIAL, SUBMITTED, APPROVED, DECLINED
  reason          String?  // Why applying (e.g., "Got baptized", "Transferred from other church")
  testimony       String?  // Detailed faith journey testimony
  previousChurch  String?  // For TRANSFER_IN requests
  targetChurch    String?  // For TRANSFER_OUT requests
  groupId         String?  // For GROUP category requests
  groupName       String?  // Group name for display
  reviewedBy      String?  // Admin who reviewed
  reviewedAt      DateTime?
  reviewNote      String?  // Admin's note
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Legacy model - keeping for backward compatibility
model MembershipRequest {
  id              String   @id @default(cuid())
  userId          String
  requestType     String   // APPLY, TRANSFER
  status          String   @default("PENDING")  // PENDING, APPROVED, DECLINED
  message         String?  // Optional message from requester
  previousChurch  String?  // For TRANSFER requests
  reviewedBy      String?  // Admin who reviewed
  reviewedAt      DateTime?
  reviewNote      String?  // Admin's note
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
